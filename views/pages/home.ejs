<%- include('../partials/header') %>

<link rel="stylesheet" href="public/css/style.css">

<body class="main-introduction">
    <main>
        <aside class="home-aside">
            <h1 class="name">
                Hi, <%= homeMainInfo.name %> here.
            </h1>

            <p class="career-description">
                <%= homeMainInfo.degree %>  Student & Aspiring <%= homeMainInfo.aspiringCareer %> 
            </p>

            <p class="brief-description">
                <%= homeMainInfo.description %>
            </p>

            <nav class="info-nav">
                <a href="/about" class="<%= page === 'about' ? 'active' : '' %>">Learn more about me</a>
                <a href="https://raw.githubusercontent.com/Phasma12-wq/CV/main/CV.pdf" download="CV.pdf" % class="CV_link">Download CV</a>
            </nav>
        </section>
    </main>
</body>



<%- include('../partials/footer') %>